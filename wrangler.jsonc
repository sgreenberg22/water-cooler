{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard if you use Git auto-deploys.
  "name": "water-cooler",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",

  // The website (index.html etc.) is served straight from ./public.
  // Only /api/* runs the Worker code.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Workers AI: 10,000 free neurons/day. No API key needed.
  "ai": { "binding": "AI" },

  // Daily cache for headlines + generated talking points.
  // No "id" on purpose: Wrangler creates the namespace on first deploy.
  // If your deploy complains, create a KV namespace in the dashboard and add "id": "<its id>" here.
  "kv_namespaces": [{ "binding": "TALK_KV" }],

  // 11:00 UTC = 6am Central (5am in winter). Pre-fetches news and warms the common packs.
  "triggers": { "crons": ["0 11 * * *"] },

  "vars": {
    // "workers-ai" (free) or "anthropic" (needs an ANTHROPIC_API_KEY secret)
    "AI_PROVIDER": "workers-ai",
    // Best humor quality on the free tier. ~225 neurons per pack ≈ 40+ packs/day free.
    // Budget option: "@cf/meta/llama-3.1-8b-instruct-fp8-fast" (≈ 6x cheaper, flatter jokes).
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // Packs generated by the 6am cron so the first person in isn't kept waiting.
    "PREWARM": "cat:top,cat:sports"
  },

  "observability": { "enabled": true }
}
